# Copy this file to .env and fill in your own values.
#
# SAFE TO SHIP: these two values are designed to be public. The anon key is
# restricted by row-level security — it can only read rows the logged-in user
# owns. See SDD §5.
#
# NEVER put the OpenRouter API key here. EXPO_PUBLIC_* variables are inlined
# into the app bundle and can be extracted from a phone in minutes. That key
# belongs in a Supabase Edge Function secret only. See SDD §3.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
